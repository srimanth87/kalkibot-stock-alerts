{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kalki-tv-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalki-tv-dashboard-db",
      "database_id": "762c674e-663b-427c-999b-d7c6ab5095ad",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
