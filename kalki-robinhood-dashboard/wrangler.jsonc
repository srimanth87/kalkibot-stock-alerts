{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kalkialerts-api",
  "main": "src/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "routes": [
    "api.kalkianalysis.com/*"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ROBINHOOD_STATE",
      "id": "be4811267edc4d56ac81f5cfe8152d03"
    }
  ],
  "d1_databases": [
    {
      "binding": "KALKI_DB",
      "database_name": "kalki-db",
      "database_id": "c7d85510-f352-4221-9024-a38792aaf33a"
    },
    {
      "binding": "KALKI_SYNC_DB",
      "database_name": "kalki-sync-db",
      "database_id": "25a847a3-828d-452a-9670-9296c62be681"
    }
  ],
  "observability": {
    "enabled": true
  }
}
