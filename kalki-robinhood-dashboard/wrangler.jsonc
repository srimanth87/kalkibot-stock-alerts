{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kalki-robinhood-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ROBINHOOD_STATE",
      "id": "be4811267edc4d56ac81f5cfe8152d03"
    }
  ],
  "d1_databases": [
    {
      "binding": "KALKI_DB",
      "database_name": "kalki-db",
      "database_id": "c7d85510-f352-4221-9024-a38792aaf33a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
