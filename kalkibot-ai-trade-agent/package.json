{
  "name": "kalkibot-ai-trade-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && node --check 'frontend/functions/api/[[path]].js'",
    "d1:init": "wrangler d1 execute kalkibot-ai-trade-agent-db --local --file migrations/0001_schema.sql",
    "d1:apply": "wrangler d1 execute kalkibot-ai-trade-agent-db --remote --file migrations/0001_schema.sql",
    "pages:dev": "wrangler pages dev frontend",
    "pages:deploy": "wrangler pages deploy frontend --project-name kalkibot-ai-trade-agent"
  },
  "devDependencies": {
    "wrangler": "^4.84.1"
  }
}
